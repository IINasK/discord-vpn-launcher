<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>DiscordVpnLauncher</AssemblyName>
    <RootNamespace>DiscordVpnLauncher</RootNamespace>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- O orquestrador PRECISA rodar como asInvoker (integridade media) para que o
         Discord herde integridade media. Nunca colocar requireAdministrator aqui. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Tudo que estiver em Resources\ e embutido e extraido para bin\ no 1o uso.
       Curinga de proposito: openvpn.exe nao roda so com wintun.dll - ele precisa
       das DLLs do OpenSSL (senao morre com 0xC0000135), e essa lista pode mudar
       entre versoes do OpenVPN. Popule a pasta com tools\get-openvpn-binaries.ps1.
       Os binarios nao sao versionados (ver .gitignore); sem eles o projeto ainda
       compila, apenas com aviso, e a falha aparece em runtime com mensagem clara. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\*" />
  </ItemGroup>

  <Target Name="AvisaRecursosAusentes" BeforeTargets="Build">
    <Warning Text="Resources\openvpn.exe ausente - o .exe compila mas nao conseguira subir a VPN."
             Condition="!Exists('Resources\openvpn.exe')" />
    <Warning Text="Resources\wintun.dll ausente - o .exe compila mas nao conseguira subir a VPN."
             Condition="!Exists('Resources\wintun.dll')" />
  </Target>

</Project>
