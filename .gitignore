# Build output
bin/
obj/
[Dd]ebug/
[Rr]elease/
publish/
*.user

# Binários de terceiros embutidos (OpenVPN + wintun + OpenSSL): pesados, e
# reproduzíveis com tools/get-openvpn-binaries.ps1.
# Padrão com ** porque Resources/ fica dentro de DiscordVpnLauncher/, não na raiz.
**/Resources/*.exe
**/Resources/*.dll

# Artefatos de runtime / logs
*.ovpn
openvpn.log
vpn-status.txt
stop.signal

# IDE
.vs/
.idea/
*.suo

# Windows
Thumbs.db
desktop.ini

# Copia do launcher na raiz do projeto (uso manual): ~75 MB de exe self-contained,
# regerado por dotnet publish - nunca versionar.
/*.exe
/*.pdb
